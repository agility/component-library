{
  "referenceName": "BackgroundHero",
  "displayName": "Background Hero",
  "kind": "component",
  "description": "A hero with either color gradient or a background image to be used at the top of a page (renders under the menu) or elsewhere rendered normally..",
  "agentGuidance": {
    "version": 1,
    "useWhen": "Opens a page with a full-width banner: a headline, a short paragraph and up to two buttons over a colour gradient or a background photo.",
    "avoidWhen": "A call to action partway down or at the end of a page (use CTABanner), or when the image belongs beside the text (use Hero).",
    "alternatives": [
      {
        "referenceName": "Hero",
        "when": "the image sits beside the text"
      },
      {
        "referenceName": "PersonalizedBackgroundHero",
        "when": "the banner must change by visitor audience"
      },
      {
        "referenceName": "CTABanner",
        "when": "a call to action that doesn't open the page"
      }
    ],
    "placement": [
      "top"
    ],
    "maxPerPage": 1
  },
  "fields": [
    {
      "name": "tab_Content",
      "label": "Content",
      "type": "Tab"
    },
    {
      "name": "Heading",
      "label": "Heading",
      "type": "Text",
      "settings": {
        "Required": "True",
        "Unique": "False",
        "CopyAcrossAllLanguages": "False"
      }
    },
    {
      "name": "Description",
      "label": "Description",
      "type": "LongText",
      "settings": {
        "Required": "True",
        "CopyAcrossAllLanguages": "False",
        "Unique": "False"
      }
    },
    {
      "name": "cta1",
      "label": "CTA 1",
      "type": "Link",
      "settings": {
        "Required": "False",
        "DefaultTarget": "False",
        "Unique": "False",
        "CopyAcrossAllLanguages": "False"
      }
    },
    {
      "name": "cta2",
      "label": "CTA 2",
      "type": "Link",
      "settings": {
        "Required": "False",
        "DefaultTarget": "False",
        "Unique": "False",
        "CopyAcrossAllLanguages": "False"
      }
    },
    {
      "name": "tab_Background",
      "label": "Background",
      "type": "Tab"
    },
    {
      "name": "Details",
      "label": "Details",
      "type": "CustomSection",
      "settings": {
        "CustomSectionValue": "Choose the colors for the gradient."
      }
    },
    {
      "name": "backgroundType",
      "label": "Background Type",
      "type": "DropdownList",
      "settings": {
        "Required": "True",
        "Unique": "False",
        "CopyAcrossAllLanguages": "False",
        "DefaultValue": "yellow-pink",
        "Choices": "Gradient - Yellow-Pink|yellow-pink\nGradient - Green-Blue-Yellow|green-blue-yellow\nGradient - Grayscale|grays\nGradient - 3-Reds|3-reds\nBackground Image|background-image"
      }
    },
    {
      "name": "BackgroundImage",
      "label": "Background Image",
      "type": "ImageAttachment",
      "settings": {
        "HideWhenFormula": "backgroundType[ne]\"background-image\"",
        "ValidFileTypes": "*.jpg,*.png,*.jpeg,*.gif,*.svg",
        "Required": "False",
        "Unique": "False",
        "CopyAcrossAllLanguages": "False",
        "DefaultUploadFolderPath": "images/hero-bgs",
        "AltTextRequired": "False"
      }
    }
  ]
}
