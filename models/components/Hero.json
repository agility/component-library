{
  "referenceName": "Hero",
  "displayName": "Hero",
  "kind": "component",
  "description": "A basic hero component with text on the side and graphic on the other.",
  "agentGuidance": {
    "version": 1,
    "useWhen": "Opens a page: a headline, a short paragraph and one button, with an image beside the text (left or right).",
    "avoidWhen": "Partway down a page (use MediaSplit), or when the opener needs a full-width background image or two buttons (use BackgroundHero).",
    "alternatives": [
      {
        "referenceName": "BackgroundHero",
        "when": "the image or a colour gradient sits behind the text"
      },
      {
        "referenceName": "MediaSplit",
        "when": "text beside an image further down the page"
      },
      {
        "referenceName": "Header",
        "when": "a plain title with no image or button"
      }
    ],
    "placement": [
      "top"
    ],
    "maxPerPage": 1,
    "fieldTips": {
      "Heading": "the page's main headline; under 10 words"
    }
  },
  "fields": [
    {
      "name": "Heading",
      "label": "Heading",
      "type": "Text",
      "settings": {
        "Required": "True",
        "Unique": "False",
        "CopyAcrossAllLanguages": "False"
      }
    },
    {
      "name": "Description",
      "label": "Description",
      "type": "LongText",
      "settings": {
        "Required": "True",
        "CopyAcrossAllLanguages": "False",
        "Unique": "False"
      }
    },
    {
      "name": "CallToAction",
      "label": "Call To Action",
      "type": "Link",
      "settings": {
        "Required": "False",
        "DefaultTarget": "False",
        "Unique": "False",
        "CopyAcrossAllLanguages": "False"
      }
    },
    {
      "name": "Image",
      "label": "Image",
      "type": "ImageAttachment",
      "settings": {
        "ValidFileTypes": "*.jpg,*.png,*.jpeg,*.gif,*.svg",
        "Required": "True",
        "Unique": "False",
        "CopyAcrossAllLanguages": "False",
        "AltTextRequired": "False"
      }
    },
    {
      "name": "ImagePosition",
      "label": "Image Position",
      "type": "DropdownList",
      "settings": {
        "Required": "True",
        "Unique": "False",
        "CopyAcrossAllLanguages": "False",
        "DefaultValue": "right",
        "Choices": "Right|right\nLeft|left"
      }
    }
  ]
}
