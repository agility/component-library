{
  "referenceName": "Testimonials",
  "displayName": "Testimonials",
  "kind": "component",
  "description": "Shows a entire list of selected testimonials.",
  "agentGuidance": {
    "version": 1,
    "useWhen": "Several customer quotes together under a heading, with an optional link to more stories.",
    "avoidWhen": "A single featured quote (use Testimonial), or logos without quotes (use LogoStrip).",
    "alternatives": [
      {
        "referenceName": "Testimonial",
        "when": "one quote"
      },
      {
        "referenceName": "LogoStrip",
        "when": "logos only"
      }
    ],
    "placement": [
      "body"
    ]
  },
  "fields": [
    {
      "name": "Subheading",
      "label": "Subheading",
      "type": "Text",
      "settings": {
        "Required": "True",
        "Unique": "False",
        "CopyAcrossAllLanguages": "False"
      }
    },
    {
      "name": "Heading",
      "label": "Heading",
      "type": "Text",
      "settings": {
        "Required": "True",
        "Unique": "False",
        "CopyAcrossAllLanguages": "False"
      }
    },
    {
      "name": "ctaText",
      "label": "CTA Text",
      "type": "Text",
      "settings": {
        "Required": "True",
        "Unique": "False",
        "CopyAcrossAllLanguages": "False"
      }
    },
    {
      "name": "ctaLink",
      "label": "CTA Link",
      "type": "Link",
      "settings": {
        "Required": "True",
        "DefaultTarget": "False",
        "Unique": "False",
        "CopyAcrossAllLanguages": "False"
      }
    },
    {
      "name": "Testimonials",
      "label": "Testimonials",
      "type": "Content",
      "settings": {
