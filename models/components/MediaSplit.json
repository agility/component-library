      }
    },
    {
      "name": "Heading",
      "label": "Heading",
      "type": "Text",
      "settings": {
        "Required": "True"
      }
    },
    {
      "name": "Body",
      "label": "Body",
      "type": "Html",
      "settings": {
        "Required": "False"
      }
    },
    {
      "name": "Image",
      "label": "Image",
      "type": "ImageAttachment",
      "settings": {
        "Required": "True"
      }
    },
    {
      "name": "ImagePosition",
      "label": "Image Position",
      "type": "DropdownList",
      "settings": {
        "Required": "True",
        "Choices": "Left|left\nRight|right",
